# 星云后端公开版配置示例
# 复制为 .env 后按实际填写。所有敏感值仅在本机 .env，绝不入仓。

# --- 核心服务 ---
NEBULA_PORT=9200
NEBULA_MCP_PORT=9300
NEBULA_DATA_DIR=./data          # 持久化数据目录（sqlite db 等），落盘物理机
NEBULA_TOKEN_FILE=./secrets/token  # Bearer token（64 hex），不入仓

# --- 嵌入 / 重排依赖（容器名或远程 URL）---
NEBULA_EMBED_URL=http://embed:8300
NEBULA_RERANK_URL=http://rerank:8301
NEBULA_EMBED_DIM=1024

# --- 模型（GGUF 文件放物理机，bind mount 进容器）---
NEBULA_MODEL_DIR=./models
EMBED_MODEL_FILE=bge-m3-Q4_K_M.gguf
RERANK_MODEL_FILE=bge-reranker-v2-m3-Q4_K_M.gguf

# 端口映射到宿主机（可选）
NEBULA_EMBED_PORT=8300
NEBULA_RERANK_PORT=8301
