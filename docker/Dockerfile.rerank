# rerank 服务: mxbai-rerank-xsmall-v1 ONNX int8 (与生产一致, 36ms/doc)
FROM python:3.11-slim
RUN pip install --no-cache-dir onnxruntime tokenizers numpy
# 模型在 build 时下载进镜像（不进 git 仓）
ARG MODEL_BASE=https://huggingface.co/mixedbread-ai/mxbai-rerank-xsmall-v1/resolve/main
RUN mkdir -p /models && \
    curl -fL --retry 3 -o /models/model_quantized.onnx "$MODEL_BASE/onnx/model_quantized.onnx" && \
    curl -fL --retry 3 -o /models/tokenizer.json "$MODEL_BASE/tokenizer.json"
COPY scripts/mxbai_rerank_server.py /app/mxbai_rerank_server.py
WORKDIR /app
EXPOSE 8301
CMD ["python3", "/app/mxbai_rerank_server.py", "8301"]
