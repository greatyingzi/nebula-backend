FROM rust:1.85-bookworm AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev pkg-config cmake && rm -rf /var/lib/apt/lists/*
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/nebula-sync-rs ./nebula-sync-rs
COPY rust/nebula-mcp-rs ./nebula-mcp-rs
WORKDIR /build
RUN cargo build --release -p nebula-sync-rs -p nebula-mcp-rs

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libsqlite3-0 curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/nebula-sync /usr/local/bin/nebula-sync
COPY --from=builder /build/target/release/nebula-mcp /usr/local/bin/nebula-mcp
ENV NEBULA_DATA=/data NEBULA_PORT=9200
VOLUME ["/data"]
EXPOSE 9200 9300
CMD ["nebula-sync"]
